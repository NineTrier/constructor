DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=constructor
DJANGO_DB_USER=constructor
DJANGO_DB_PASSWORD=constructor
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
DJANGO_SECURE_PROXY_SSL_HEADER=1
DJANGO_FORCE_SECURE_SCHEME=0
DJANGO_AUTO_IMPORT_DUMP=1
DJANGO_FIXTURE_PATH=/app/backup.json
DJANGO_SUPERUSER_USERNAME=admin1
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

POSTGRES_DB=constructor
POSTGRES_USER=constructor
POSTGRES_PASSWORD=constructor

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
