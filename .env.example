# Django
DJANGO_SECRET_KEY=replace-me-with-a-secure-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=constructor
DJANGO_DB_USER=constructor
DJANGO_DB_PASSWORD=constructor
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
DJANGO_SECURE_PROXY_SSL_HEADER=1
DJANGO_FORCE_SECURE_SCHEME=1
DJANGO_AUTO_IMPORT_DUMP=1
DJANGO_FIXTURE_PATH=/app/backup.json
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Database container
POSTGRES_DB=constructor
POSTGRES_USER=constructor
POSTGRES_PASSWORD=constructor

# Gunicorn (optional overrides)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# Host bind mounts (Windows paths by default)
HOST_STATIC_PATH=C:/constructor/static
HOST_MEDIA_PATH=C:/constructor/media
HOST_POSTGRES_PATH=C:/constructor/postgres
HOST_PGADMIN_PATH=C:/constructor/pgadmin
HOST_BACKUP_PATH=C:/constructor/backup

# DB backups (db_backup service)
BACKUP_POSTGRES_HOST=db
BACKUP_POSTGRES_PORT=5432
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_RUN_ON_START=1

# database_manager SQL migration feature flags
DBM_READ_FROM_SQL=0
DBM_DUAL_WRITE=0
DBM_DUAL_WRITE_STRICT_FOR_TESTS=0
DBM_SQL_SOURCE_OF_TRUTH=0
DBM_SQL_WRITE_FILE_SECONDARY=1
DBM_UI_V1_ONLY=0
DBM_UI_USE_API_FOR_MUTATIONS=1
DBM_UI_LEGACY_FALLBACK=0
DBM_LINKS_META_UI=1
DBM_DISABLE_LEGACY_LINKED_PARAMS=0
DOC_TOKEN_HUMAN_STRICT=0
DOCUMENT_LINK_TREE_UI=1
DOCUMENT_VARIABLES_TREE_UNIFIED_UI=1
DOCUMENT_LINK_TREE_DEBUG=0
